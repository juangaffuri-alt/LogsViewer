@{
    ViewData["Title"] = "LogsViewer";
}

<div class="landing-container">
    <div class="landing-hero">
        <img src="~/images/bpnlogo-white.png" alt="BPN" style="height: 60px;" />
        <h1>LogsViewer</h1>
        <p class="lead">Centralizá, buscá y analizá los logs de todas tus aplicaciones.</p>
    </div>

    <div class="landing-features">
        <div class="feature-card">
            <i class="fa fa-search"></i>
            <h5>Búsqueda avanzada</h5>
            <p>Filtrá por aplicación, nivel, rango de tiempo y palabras dentro del mensaje.</p>
        </div>
        <div class="feature-card">
            <i class="fa fa-bar-chart"></i>
            <h5>Dashboards</h5>
            <p>Visualizá tendencias, distribución por nivel y top de errores.</p>
        </div>
        <div class="feature-card">
            <i class="fa fa-shield"></i>
            <h5>Multi-aplicación</h5>
            <p>Centralizá los logs de todos tus servicios en un solo lugar.</p>
        </div>
    </div>

    <div class="landing-cta">
        <a href="/Account/Login" class="btn btn-primary btn-lg">
            <i class="fa fa-sign-in"></i> Iniciar sesión
        </a>
        <p class="text-muted mt-3">Necesitás una cuenta para acceder a los logs.</p>
    </div>
</div>