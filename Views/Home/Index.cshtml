@model DashboardViewModel
@{
    ViewData["Title"] = "Discover - Logger Viewer";
}

<div class="discover-container">
    <div class="discover-header">
        <h1><i class="fa fa-binoculars"></i> Discover</h1>
        <p class="text-muted">Explora y analiza tus logs en tiempo real</p>
    </div>

    <!-- Estadísticas principales -->
    <div class="discover-stats">
        <div class="stat-card">
            <div class="stat-icon error">
                <i class="fa fa-exclamation-circle"></i>
            </div>
            <div class="stat-content">
                <h6>Errores</h6>
                <p class="stat-value" id="stat-errors">@Model.Statistics.ErrorCount</p>
                <small class="stat-percentage">@Model.Statistics.ErrorPercentage.ToString("F1")%</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fa fa-warning"></i>
            </div>
            <div class="stat-content">
                <h6>Advertencias</h6>
                <p class="stat-value" id="stat-warnings">@Model.Statistics.WarningCount</p>
                <small class="stat-percentage">@Model.Statistics.WarningPercentage.ToString("F1")%</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon info">
                <i class="fa fa-info-circle"></i>
            </div>
            <div class="stat-content">
                <h6>Información</h6>
                <p class="stat-value" id="stat-infos">@Model.Statistics.InfoCount</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fa fa-server"></i>
            </div>
            <div class="stat-content">
                <h6>Total de Logs</h6>
                <p class="stat-value" id="stat-total">@Model.Statistics.TotalLogs</p>
            </div>
        </div>
    </div>

    <!-- Timeline Chart -->
    <div class="chart-section">
        <h5><i class="fa fa-line-chart"></i> Timeline de Logs</h5>
        <div id="timeline-chart" style="height: 300px;" class="chart-container"></div>
    </div>

    <!-- Logs Recientes -->
    <div class="recent-logs-section">
        <div class="section-header">
            <h5><i class="fa fa-clock-o"></i> Logs Recientes</h5>
            <a href="/logs" class="btn btn-sm btn-outline-primary">
                <i class="fa fa-arrow-right"></i> Ver todos
            </a>
        </div>
        <div id="logs-list-container">
            @if (Model.RecentLogs.Any())
            {
                @foreach (var log in Model.RecentLogs)
                {
                    <div class="log-card">
                        <div class="log-header">
                            <span class="log-level @log.Level.ToLower()">
                                @log.Level
                            </span>
                            <span class="log-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                            <span class="log-source">@log.Source</span>
                        </div>
                        <div class="log-message">@log.Message</div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fa fa-inbox"></i>
                    <h4>Todavía no llegaron logs</h4>
                    <p>Envía eventos al endpoint <code>/api/events/raw</code> para verlos acá.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.timelineData = {
            timestamps: [@Html.Raw(string.Join(",", Model.TimeSeriesData.Timestamps.Select(t => $"\"{t}\"")))],
            error: [@string.Join(",", Model.TimeSeriesData.ErrorCounts)],
            warning: [@string.Join(",", Model.TimeSeriesData.WarningCounts)],
            info: [@string.Join(",", Model.TimeSeriesData.InfoCounts)],
            debug: [@string.Join(",", Model.TimeSeriesData.DebugCounts)]
        };
    </script>
    <script src="~/js/charts.js"></script>
}