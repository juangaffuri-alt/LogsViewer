@using System.Security.Claims
@using LogsViewer.Models.Filters
@inject LogsViewer.Services.LogFilterPreferencesService FilterService
@{
    var prefs = FilterService.Get();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <base href="~/" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- ApexCharts CSS -->
    <link rel="stylesheet" href="~/lib/apexcharts/apexcharts.css" />

    <!-- Kibana Theme CSS -->
    <link href="~/css/kibana-theme.css" rel="stylesheet" />

    <!-- Page content styling (stat cards, log cards, charts) -->
    <link href="~/css/pages.css" rel="stylesheet" />
    <!-- Bootstrap icon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="kibana-container">
        <!-- Navbar Superior -->
        <nav class="kibana-navbar">
            <div class="navbar-brand">
                <img src="~/images/bpnlogo-white.png" alt="Logo" style="height: 40px; width: auto; margin-right: 12px;">
                <span>LogsViewer</span>
            </div>

            
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Desarrollo"))
            {
                <div class="navbar-search">
                    <input type="text" class="search-input" id="global-search"
                           placeholder="🔍 Search logs..."
                           autocomplete="off"
                           value="@Context.Request.Query["query"]" />
                    <div id="recent-searches" class="recent-searches-dropdown d-none">
                        <div class="recent-searches-header">
                            <span>Búsquedas recientes</span>
                            <button type="button" id="clear-recent-searches" class="btn-clear-recent">
                                Limpiar
                            </button>
                        </div>
                        <ul id="recent-searches-list" class="recent-searches-list"></ul>
                    </div>
                </div>
            }

            
            <div class="navbar-menu">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/dashboard" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="fa fa-bar-chart"></i> Dashboard
                    </a>
                    <a href="/logs" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "active" : "")">
                        <i class="fa fa-list"></i> Logs
                    </a>
                    <a href="/apikeys" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ApiKeys" ? "active" : "")">
                        <i class="fa fa-key"></i> API Keys
                    </a>
                }
            </div>

            <div class="navbar-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var givenname = User.Claims.Where(c => c.Type == ClaimTypes.GivenName).Select(c => c.Value).FirstOrDefault();
                    var surname = User.Claims.Where(c => c.Type == ClaimTypes.Surname).Select(c => c.Value).FirstOrDefault();
                    var iniciales = $"{givenname?.Substring(0, 1)}{surname?.Substring(0, 1)}";

                    // 👇 Obtener roles del usuario (ajustá el tipo de claim si tu IdP usa otro)
                    var roles = User.Claims
                        .Where(c => c.Type == ClaimTypes.Role || c.Type == "role")
                        .Select(c => c.Value)
                        .Distinct()
                        .OrderBy(r => r)
                        .ToList();

                    <div class="dropdown user-dropdown">
                        <button class="btn-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar">@iniciales</span>
                            <span class="user-display-name">@givenname @surname</span>
                            <i class="fa fa-chevron-down user-caret"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">
                            <li class="dropdown-header">
                                <div class="user-dropdown-header">
                                    <div class="user-avatar-lg">@iniciales</div>
                                    <div class="user-dropdown-info">
                                        <div class="user-dropdown-name">@givenname @surname</div>
                                        <div class="user-dropdown-email">@User.Identity.Name</div>
                                    </div>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li class="dropdown-header-inline">
                                <i class="fa fa-shield"></i> Roles asignados
                            </li>

                            @if (roles.Any())
                            {
                                foreach (var role in roles)
                                {
                                    <li>
                                        <span class="dropdown-item role-item">
                                            <i class="fa fa-circle role-dot"></i>
                                            @role
                                        </span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li>
                                    <span class="dropdown-item text-muted small">Sin roles asignados</span>
                                </li>
                            }

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item logout-item">
                                        <i class="fa fa-sign-out"></i> Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="btn-login" title="Iniciar sesión">
                        <i class="fa fa-sign-in"></i>
                        <span>Iniciar sesión</span>
                    </a>
                }
            </div>
        </nav>

        <div class="kibana-main">
            <!-- Sidebar -->
            @{
                var qsLevels = Context.Request.Query["levels"];
                var activeLevels = qsLevels.Count > 0
                    ? qsLevels.ToArray()!
                    : new[] { "ERROR", "WARNING", "INFO", "DEBUG" };
                var activeTimeRange = Context.Request.Query["timeRange"].FirstOrDefault() ?? "24h";
                var activeQuery = Context.Request.Query["query"].FirstOrDefault();
            }
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Desarrollo"))
            {
                <aside class="kibana-sidebar" id="kibana-sidebar">
                    <form id="sidebar-filters-form" method="post" asp-controller="Preferences" asp-action="SetFilters">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                        <!-- Rango -->
                        <div class="filter-section">
                            <label class="filter-label">Rango</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-clock-history"></i></span>
                                <select class="form-select" name="TimeRange"
                                        onchange="document.getElementById('sidebar-filters-form').submit()">
                                    @foreach (var range in TimeRangeExtensions.All)
                                    {
                                        <option value="@range" selected="@(range == prefs.TimeRange)">@range.ToDisplay()</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Niveles -->
                        <div class="filter-section">
                            <label class="filter-label">Niveles</label>
                            <div class="level-chips">
                                @foreach (var level in LogLevelInfo.All)
                                {
                                    var style = LogLevelInfo.Get(level);
                                    var isChecked = prefs.Levels.Contains(level);
                                    <label class="level-chip" style="--level-color: @style.Color">
                                        <input class="level-chip-input" type="checkbox"
                                               name="Levels" value="@level"
                                               checked="@isChecked" />
                                        <i class="bi @style.Icon"></i>
                                        <span>@style.DisplayName</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Aplicación -->
                        <div class="filter-section">
                            <label class="filter-label">Aplicación</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-app-indicator"></i></span>
                                <select class="form-select" name="Application">
                                    <option value="" selected="@(prefs.Application == null)">Todas las aplicaciones</option>
                                    @foreach (var app in FilterService.GetApplicationsCached())
                                    {
                                        <option value="@app" selected="@(prefs.Application == app)">@app</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Botonera -->
                        <div class="filter-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-reset-filters"
                                    title="Limpiar filtros">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                                <i class="bi bi-funnel-fill me-1"></i> Aplicar
                            </button>
                        </div>
                    </form>

                    <div class="sidebar-section">
                        <h6 class="filter-label">Búsquedas guardadas</h6>
                        <div class="saved-searches">
                            <a href="/logs?query=ERROR" class="saved-search-link">
                                <i class="bi bi-star"></i> Errores recientes
                            </a>
                            <a href="/logs?query=timeout" class="saved-search-link">
                                <i class="bi bi-star"></i> Performance issues
                            </a>
                            <a href="/logs?query=Exception" class="saved-search-link">
                                <i class="bi bi-star"></i> Exceptions
                            </a>
                        </div>
                    </div>
                </aside>
            }
            <!-- Contenido Principal -->
            <main class="kibana-content">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </main>
        </div>

    </div>

    <!-- Modal de confirmación -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content kibana-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmTitle">Confirmación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmMessage">
                    ¿Estás seguro?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i> No
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmBtn">
                        <i class="fa fa-check"></i> Sí
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error UI -->
    <div id="blazor-error-ui" style="display:none;">
        An error has occurred. This application may no longer respond until reloaded.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/kibana-app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function() {
        const input = document.getElementById('global-search');
        if (!input) return;

        // Determina a qué controlador ir según dónde estés parado
        const currentController = '@ViewContext.RouteData.Values["controller"]';
        // Si ya estás en Search, quedate en Search; si no, andá a Search igual
        // (la idea es que este quick search siempre busque, no navegue a /logs)
        const targetUrl = '/Logs';

        function go() {
        const query = input.value.trim();
        if (!query) return;
        window.location.href = `${targetUrl}?query=${encodeURIComponent(query)}`;
        }

        // Enter dispara la búsqueda
        input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
        e.preventDefault();
        go();
        }
        // Escape limpia el input
        if (e.key === 'Escape') {
        input.value = '';
        input.blur();
        }
        });

        // Atajo Ctrl+K / Cmd+K
        document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
        }
        });
        })();
        document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
        const form = document.getElementById('sidebar-filters-form');
        if (!form) return;

        // Resetear el select de rango al default
        form.querySelector('select[name="TimeRange"]').value = 'Last24Hours';

        // Desmarcar todos los niveles excepto Info y Warning (o todos)
        form.querySelectorAll('input[name="Levels"]').forEach(cb => {
        cb.checked = false;
        });

        // Resetear aplicación a "todas"
        form.querySelector('select[name="Application"]').value = '';

        // Enviar el form
        form.submit();
        });
        (function () {
        const STORAGE_KEY = 'logsviewer.recent_searches';
        const MAX_RECENT = 6;

        const input = document.getElementById('global-search');
        if (!input) return;

        const dropdown = document.getElementById('recent-searches');
        const list = document.getElementById('recent-searches-list');
        const clearBtn = document.getElementById('clear-recent-searches');

        // ---------- Storage ----------
        function getRecent() {
        try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
        } catch {
        return [];
        }
        }

        function saveRecent(query) {
        if (!query) return;
        let recents = getRecent().filter(q => q !== query);
        recents.unshift(query);
        recents = recents.slice(0, MAX_RECENT);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(recents));
        }

        function clearRecent() {
        localStorage.removeItem(STORAGE_KEY);
        }

        // ---------- Render ----------
        function render() {
        const recents = getRecent();

        if (recents.length === 0) {
        list.innerHTML = '<li class="recent-searches-empty">Todavía no hiciste búsquedas</li>';
        dropdown.classList.remove('d-none');
        return;
        }

        list.innerHTML = recents.map(q => `
        <li>
        <a href="/Logs?query=${encodeURIComponent(q)}" data-query="${q.replace(/"/g, '&quot;')}">
        <i class="bi bi-clock-history"></i>
        <span class="recent-query-text">${escapeHtml(q)}</span>
        </a>
        </li>
        `).join('');

        dropdown.classList.remove('d-none');
        }

        function escapeHtml(s) {
        return s.replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[c]);
        }

        // ---------- Interacción ----------
        input.addEventListener('focus', render);
        input.addEventListener('click', render);

        input.addEventListener('blur', () => {
        // Delay para permitir el click en una sugerencia
        setTimeout(() => dropdown.classList.add('d-none'), 150);
        });

        // Navegación con flechas dentro del dropdown
        input.addEventListener('keydown', (e) => {
        const items = dropdown.querySelectorAll('.recent-searches-list li a');
        const current = dropdown.querySelector('.recent-searches-list li a.active');

        if (e.key === 'ArrowDown' && items.length) {
        e.preventDefault();
        if (!current) items[0].classList.add('active');
        else {
        current.classList.remove('active');
        const i = Array.from(items).indexOf(current);
        items[(i + 1) % items.length].classList.add('active');
        }
        }

        if (e.key === 'ArrowUp' && items.length) {
        e.preventDefault();
        if (!current) items[items.length - 1].classList.add('active');
        else {
        current.classList.remove('active');
        const i = Array.from(items).indexOf(current);
        items[(i - 1 + items.length) % items.length].classList.add('active');
        }
        }

        if (e.key === 'Enter') {
        e.preventDefault();
        if (current) {
        window.location.href = current.getAttribute('href');
        } else if (input.value.trim()) {
        saveRecent(input.value.trim());
        window.location.href = `/Logs?query=${encodeURIComponent(input.value.trim())}`;
        }
        }

        if (e.key === 'Escape') {
        input.value = '';
        input.blur();
        }
        });

        // Click en una sugerencia
        list.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;
        saveRecent(link.dataset.query);
        });

        // Limpiar
        clearBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        clearRecent();
        render();
        });

        // Ctrl+K / Cmd+K
        document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
        }
        });
        })();
    </script>
</body>
</html>