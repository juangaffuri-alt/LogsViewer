@using LogsViewer.Models.Filters
@inject LogsViewer.Services.LogFilterPreferencesService FilterService
@{
    var prefs = FilterService.Get();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <base href="~/" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- ApexCharts CSS -->
    <link rel="stylesheet" href="~/lib/apexcharts/apexcharts.css" />

    <!-- Kibana Theme CSS -->
    <link href="~/css/kibana-theme.css" rel="stylesheet" />

    <!-- Page content styling (stat cards, log cards, charts) -->
    <link href="~/css/pages.css" rel="stylesheet" />
    <!-- Bootstrap icon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <div class="kibana-container">
        <!-- Navbar Superior -->
        <nav class="kibana-navbar">
            <div class="navbar-brand">
                <img src="~/images/bpnlogo-white.png" alt="Logo" style="height: 40px; width: auto; margin-right: 12px;">
                <span>LogsViewer</span>
            </div>

            <div class="navbar-search">
                <input type="text" class="search-input" id="global-search"
                       placeholder="🔍 Search logs..."
                       autocomplete="off" />
            </div>

            <div class="navbar-menu">
                <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fa fa-th-large"></i> Discover
                </a>
                <a href="/logs" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Logs" ? "active" : "")">
                    <i class="fa fa-list"></i> Logs
                </a>
                <a href="/dashboard" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fa fa-bar-chart"></i> Dashboard
                </a>
                <a href="/search" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Search" ? "active" : "")">
                    <i class="fa fa-search"></i> Search
                </a>
            </div>

            <div class="navbar-actions">
                <button class="btn-icon" title="Notifications" id="btn-notifications">
                    <i class="fa fa-bell-o"></i>
                </button>
                <button class="btn-icon" title="Settings" id="btn-settings">
                    <i class="fa fa-sliders"></i>
                </button>
                <button class="btn-icon" title="User Menu" id="btn-user">
                    <i class="fa fa-user-circle"></i>
                </button>
            </div>
        </nav>

        <div class="kibana-main">
            <!-- Sidebar -->
            @{
                var qsLevels = Context.Request.Query["levels"];
                var activeLevels = qsLevels.Count > 0
                    ? qsLevels.ToArray()!
                    : new[] { "ERROR", "WARNING", "INFO", "DEBUG" };
                var activeTimeRange = Context.Request.Query["timeRange"].FirstOrDefault() ?? "24h";
                var activeQuery = Context.Request.Query["query"].FirstOrDefault();
            }
            <aside class="kibana-sidebar" id="kibana-sidebar">
                <form id="sidebar-filters-form" method="post" asp-controller="Preferences" asp-action="SetFilters">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                    <!-- Rango -->
                    <label class="form-label small text-uppercase fw-semibold text-muted">Rango</label>
                    <select class="form-select form-select-sm mb-3" name="TimeRange"
                            onchange="document.getElementById('sidebar-filters-form').submit()">
                        @foreach (var range in TimeRangeExtensions.All)
                        {
                            <option value="@range" selected="@(range == prefs.TimeRange)">@range.ToDisplay()</option>
                        }
                    </select>

                    <!-- Niveles -->
                    <label class="form-label small text-uppercase fw-semibold text-muted">Niveles</label>
                    <div class="level-filter-list">
                        @foreach (var level in LogLevelInfo.All)
                        {
                            var style = LogLevelInfo.Get(level);
                            var isChecked = prefs.Levels.Contains(level);
                            <label class="level-filter-item" for="level-@level" style="--level-color: @style.Color">
                                <input class="form-check-input" type="checkbox"
                                       name="Levels" value="@level"
                                       id="level-@level"
                                       checked="@isChecked" />
                                <i class="bi @style.Icon level-icon"></i>
                                <span class="level-name">@style.DisplayName</span>
                            </label>
                        }
                    </div>

                    <!-- Aplicación (usando el cache) -->
                    <label class="form-label small text-uppercase fw-semibold text-muted mt-3">Aplicación</label>
                    <select class="form-select form-select-sm mb-3" name="Application">
                        <option value="" selected="@(prefs.Application == null)">Todas las aplicaciones</option>
                        @foreach (var app in FilterService.GetApplicationsCached())
                        {
                            <option value="@app" selected="@(prefs.Application == app)">@app</option>
                        }
                    </select>

                    <!-- Botón Aplicar -->
                    <button type="submit" class="btn btn-primary btn-sm w-100 mt-3">
                        <i class="bi bi-funnel-fill me-1"></i> Aplicar filtros
                    </button>
                </form>

                <div class="sidebar-section">
                    <h6>BÚSQUEDAS GUARDADAS</h6>
                    <div class="saved-searches">
                        <a href="/logs?levels=ERROR" class="saved-search-link">
                            <i class="fa fa-star-o"></i> Errores recientes
                        </a>
                        <a href="/logs?query=timeout" class="saved-search-link">
                            <i class="fa fa-star-o"></i> Performance issues
                        </a>
                        <a href="/logs?query=Exception" class="saved-search-link">
                            <i class="fa fa-star-o"></i> Exceptions
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Contenido Principal -->
            <main class="kibana-content">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content kibana-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmTitle">Confirmación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="confirmMessage">
                    ¿Estás seguro?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa fa-times"></i> No
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmBtn">
                        <i class="fa fa-check"></i> Sí
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error UI -->
    <div id="blazor-error-ui" style="display:none;">
        An error has occurred. This application may no longer respond until reloaded.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/kibana-app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        (function() {
        const input = document.getElementById('global-search');
        if (!input) return;

        // Determina a qué controlador ir según dónde estés parado
        const currentController = '@ViewContext.RouteData.Values["controller"]';
        // Si ya estás en Search, quedate en Search; si no, andá a Search igual
        // (la idea es que este quick search siempre busque, no navegue a /logs)
        const targetUrl = '/Search';

        function go() {
        const query = input.value.trim();
        if (!query) return;
        window.location.href = `${targetUrl}?query=${encodeURIComponent(query)}`;
        }

        // Enter dispara la búsqueda
        input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
        e.preventDefault();
        go();
        }
        // Escape limpia el input
        if (e.key === 'Escape') {
        input.value = '';
        input.blur();
        }
        });

        // Atajo Ctrl+K / Cmd+K
        document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
        }
        });
        })();
    </script>
</body>
</html>