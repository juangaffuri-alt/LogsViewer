@model LogsPageViewModel
@{
    ViewData["Title"] = "Logs - Logger Viewer";
}

<div class="logs-viewer">
    <div class="logs-header">
        <h1>
            <i class="fa fa-list"></i> Logs Viewer
        </h1>
        <div class="header-actions">
            <button class="btn btn-sm btn-outline-secondary" id="btn-refresh" title="Actualizar">
                <i class="fa fa-refresh"></i> Actualizar
            </button>
            <button class="btn btn-sm btn-outline-secondary" id="btn-export" title="Exportar como CSV">
                <i class="fa fa-download"></i> Exportar
            </button>
            <button class="btn btn-sm btn-outline-secondary" id="btn-settings-logs" title="Configurar columnas">
                <i class="fa fa-cog"></i> Columnas
            </button>
        </div>
    </div>

    <!-- Información de búsqueda -->
    <div class="search-info">
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <span class="badge bg-info">
                <i class="fa fa-search"></i> Buscando: <strong>@Model.SearchQuery</strong>
            </span>
        }

        <span class="badge bg-secondary">
            Total: <strong>@Model.TotalCount</strong> resultados
        </span>

        <span class="badge bg-secondary">
            Mostrando: <strong>@Model.Logs.Count</strong>
        </span>
    </div>

    <!-- Filtros activos -->
    @if (Model.SelectedLevels.Any())
    {
        <div class="active-filters">
            <label>Filtros activos:</label>
            @foreach (var level in Model.SelectedLevels)
            {
                <span class="filter-chip">
                    <i class="fa fa-filter"></i> @level
                    <button class="btn-chip-close" data-level="@level">
                        <i class="fa fa-times"></i>
                    </button>
                </span>
            }
        </div>
    }

    <!-- Lista de Logs -->
    <div class="logs-container">
        @if (Model.Logs.Any())
        {
            <div class="logs-list" id="logs-list">
                @foreach (var log in Model.Logs)
                {
                    <div class="log-card" data-id="@log.Id">
                        <div class="log-header">
                            <span class="log-level @log.Level.ToLower()">
                                <i class="fa fa-@GetLogIcon(log.Level)"></i>
                                @log.Level
                            </span>
                            <span class="log-timestamp">@log.Timestamp:yyyy-MM-dd HH:mm:ss.fff</span>
                            <span class="log-source">@log.Source</span>
                        </div>
                        <div class="log-message">@log.Message</div>

                        @if (log.Properties?.Any() ?? false)
                        {
                            <details class="log-details">
                                <summary><i class="fa fa-chevron-right"></i> Propiedades (@log.Properties.Count)</summary>
                                <div class="log-properties">
                                    @foreach (var prop in log.Properties)
                                    {
                                        <div class="property-item">
                                            <span class="property-key">@prop.Key:</span>
                                            <span class="property-value">@prop.Value</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }

                        @if (!string.IsNullOrEmpty(log.Exception))
                        {
                            <details class="log-exception">
                                <summary><i class="fa fa-exclamation-circle"></i> Excepción</summary>
                                <pre class="exception-text">@log.Exception</pre>
                                @if (!string.IsNullOrEmpty(log.StackTrace))
                                {
                                    <details>
                                        <summary>Stack Trace</summary>
                                        <pre class="stack-trace">@log.StackTrace</pre>
                                    </details>
                                }
                            </details>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa fa-inbox"></i>
                <h4>No hay logs disponibles</h4>
                <p>No se encontraron logs con los filtros actuales</p>
            </div>
        }

        <!-- Paginación -->
        @if (Model.TotalPages > 1)
        {
            <nav class="logs-pagination" aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-left"></i>
                            </a>
                        </li>
                    }

                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                @i
                            </a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-double-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/logs-viewer.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
        LogsViewer.init({
        currentPage: @Model.CurrentPage,
        pageSize: @Model.PageSize,
        totalCount: @Model.TotalCount
        });
        });
    </script>
}

@functions {
    private string GetLogIcon(string level) => level.ToUpper() switch
    {
        "ERROR" => "times-circle",
        "WARNING" => "exclamation-triangle",
        "INFO" => "info-circle",
        "DEBUG" => "bug",
        "TRACE" => "code",
        _ => "circle"
    };
}