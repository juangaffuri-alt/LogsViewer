@model LogsPageViewModel
@{
    ViewData["Title"] = "Logs - Logger Viewer";
}

<link rel="stylesheet" href="~/css/logs.css" asp-append-version="true" />

<div class="logs-page">
    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between py-2 mb-3">
            <span>
                <i class="bi bi-search me-1"></i>
                Resultados para: <strong>@Model.SearchQuery</strong>
                <span class="text-muted ms-2">(@Model.TotalCount logs)</span>
            </span>
            <a href="/logs" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x"></i> Limpiar
            </a>
        </div>
    }
    <div class="logs-header">
        <div class="logs-header-title">
            <h1><i class="fa fa-list-alt"></i> Logs</h1>
            <span class="logs-count">@Model.TotalCount registros</span>
        </div>
        <div class="logs-toolbar">
            <button type="button" id="btn-refresh" class="btn btn-outline-secondary">
                <i class="fa fa-sync-alt"></i> <span>Actualizar</span>
            </button>
            <button type="button" id="btn-export" class="btn btn-outline-secondary">
                <i class="fa fa-file-export"></i> <span>Exportar</span>
            </button>
            <div class="view-switch-wrapper">
                <span class="view-switch-label">Vista:</span>
                <div class="btn-group view-switch" role="group" aria-label="Vista">
                    <button type="button" class="btn btn-outline-secondary view-toggle" data-view="grid">
                        <i class="fa fa-list"></i> <span>Grilla</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary view-toggle" data-view="card">
                        <i class="fa fa-th-large"></i> <span>Tarjetas</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Logs.Any())
    {
        <div class="logs-empty">
            <i class="fa fa-inbox"></i>
            <p>No hay logs para mostrar.</p>
        </div>
    }
    else
    {
        <!-- Vista grilla (default) -->
        <div id="logs-grid" class="logs-grid">
            <table class="logs-table">
                <thead>
                    <tr>
                        <th class="col-level">Nivel</th>
                        <th class="col-timestamp">Fecha</th>
                        <th class="col-app">Aplicación</th>
                        <th class="col-source">Origen</th>
                        <th class="col-message">Mensaje</th>
                        <th class="col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Logs.Count; i++)
                    {
                        var log = Model.Logs[i];
                        var level = log.Level.ToQueryString().ToLower(); // o log.Level.ToString().ToLower()
                        var propsId = $"props-{i}";
                        var hasProps = log.HasProperties;
                        var hasException = !string.IsNullOrWhiteSpace(log.Exception);

                        <tr class="log-row level-@level">
                            <td><span class="log-level @level">@log.Level.ToDisplay()</span></td>
                            <td class="log-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            <td class="log-app">
                                @HighlightHelper.Highlight(log.Application, Model.SearchQuery)
                            </td>
                            <td class="log-source">
                                @HighlightHelper.Highlight(log.Source, Model.SearchQuery)
                            </td>
                            <td class="log-message">
                                @HighlightHelper.Highlight(log.Message, Model.SearchQuery)
                            </td>
                            <td class="log-actions">
                                @if (hasProps)
                                {
                                    <button type="button" class="btn-expand" data-target="@propsId" title="Propiedades">
                                        <i class="fa fa-chevron-down"></i>
                                    </button>
                                }
                            </td>
                        </tr>

                        @if (hasException)
                        {
                            var exText = log.Exception!.Trim();
                            var firstNl = exText.IndexOf('\n');
                            var exMessage = firstNl > 0 ? exText[..firstNl].Trim() : exText;
                            var exStack = firstNl > 0 ? exText[(firstNl + 1)..].Trim() : null;

                            <tr class="log-exception-row">
                                <td colspan="5">
                                    <div class="log-exception">
                                        <div class="log-exception-header">
                                            <i class="fa fa-exclamation-triangle"></i>
                                            <span>Excepción</span>
                                            <button type="button" class="btn-copy" title="Copiar"
                                                    data-copy="@exText.Replace("\"", "&quot;")">
                                                <i class="fa fa-copy"></i>
                                            </button>
                                        </div>
                                        <div class="log-exception-message">@exMessage</div>
                                        @if (!string.IsNullOrWhiteSpace(exStack))
                                        {
                                            <pre class="log-exception-stack">@exStack</pre>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (hasProps)
                        {
                            <tr class="log-details-row" id="@propsId" hidden>
                                <td colspan="5">
                                    <div class="log-props-header">Propiedades</div>
                                    <pre>@log.PropertiesJson</pre>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Vista tarjetas (alternativa) -->
        <div id="logs-card" class="logs-card" hidden>
            @foreach (var log in Model.Logs)
            {
                var level = log.Level.ToQueryString().ToLower(); // o log.Level.ToString().ToLower()
                var hasProps = log.HasProperties;
                var hasException = !string.IsNullOrWhiteSpace(log.Exception);

                <div class="log-card level-@level">
                    <div class="log-card-header">
                        <span class="log-level @level">@log.Level.ToDisplay()</span>
                        <span class="log-timestamp">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                        <span class="log-source">
                            @HighlightHelper.Highlight(log.Source, Model.SearchQuery)
                        </span>
                    </div>
                    <div class="log-card-message">
                        @HighlightHelper.Highlight(log.Message, Model.SearchQuery)
                    </div>

                    @if (hasException)
                    {
                        <div class="log-exception">
                            <div class="log-exception-header">
                                <i class="fa fa-exclamation-triangle"></i> Excepción
                            </div>
                            <pre>@log.Exception</pre>
                        </div>
                    }

                    @if (hasProps)
                    {
                        <details class="log-details">
                            <summary>Propiedades</summary>
                            <pre>@log.PropertiesJson</pre>
                        </details>
                    }
                </div>
            }
        </div>

        <!-- Paginación server-side (igual que antes) -->
        @if (Model.TotalPages > 1)
        {
            <nav class="logs-pagination" aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-left"></i>
                            </a>
                        </li>
                    }
                    @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = Model.PageSize, query = Model.SearchQuery })">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize, query = Model.SearchQuery })">
                                <i class="fa fa-angle-double-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script src="~/js/logs-viewer.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            LogsViewer.init({
                currentPage: @Model.CurrentPage,
                pageSize: @Model.PageSize,
                totalCount: @Model.TotalCount
            });
        });
        document.querySelectorAll('.btn-copy').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const text = e.currentTarget.dataset.copy;
                navigator.clipboard.writeText(text).then(() => {
                const icon = e.currentTarget.querySelector('i');
                if (!icon) return;
                const original = icon.className;
                icon.className = 'fa fa-check';
                setTimeout(() => { icon.className = original; }, 1200);
                });
            });
        });
    </script>
}